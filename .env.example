# Database
POSTGRES_USER=bitlink
POSTGRES_PASSWORD=bitlink
POSTGRES_DB=bitlink
DATABASE_URL=postgresql+psycopg://bitlink:bitlink@db:5432/bitlink

# API
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Short links / short QR base. Production: https://bitlink.click
# Leave empty locally to reuse PUBLIC_WEB_URL.
PUBLIC_SHORT_BASE_URL=
# Absolute public API origin embedded in uploaded media URLs.
# Production: https://bitlink-production.up.railway.app
PUBLIC_API_URL=http://localhost:8000
MEDIA_ROOT=/app/media
# Set false in production once email delivery is wired
EXPOSE_RESET_URL=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
